 "prepared_report": 0,
 "query": "SELECT\n    shop.airport,\n    COUNT(CASE WHEN shop.status = 'Available' THEN 1 END) AS available_shops,\n    COUNT(CASE WHEN shop.status = 'Leased' THEN 1 END) AS occupied_shops,\n    COUNT(shop.name) AS total_shops\nFROM\n    `tabShop` shop\nWHERE\n    (%(airport)s IS NULL OR shop.airport = %(airport)s)\nGROUP BY\n    shop.airport\nORDER BY\n    shop.airport;\n",
 "ref_doctype": "Shop",
 "report_name": "Shop Utilization Overview",
 "report_type": "Query Report",
